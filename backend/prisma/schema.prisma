generator client {
  provider = "prisma-client"
  output   = "./generated"
  engineType = "client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Book {
  id              Int      @id @default(autoincrement())
  title           String
  author          String
  language        String?
  publishingHouse String?
  format          String
  publishedDate   String?
  description     String?
  coverUrl        String?
  createdAt       DateTime @default(now())
  // Legacy Xenova (MiniLM) embedding. The app no longer writes to this
  // column since the Xenova dependency was dropped in favor of Gemma
  // (via Ollama) — kept only so existing data isn't lost. Safe to drop
  // in a future migration once that's confirmed unneeded.
  embedding       Unsupported("vector(384)")?
  embeddingGemma  Unsupported("vector(768)")?
}